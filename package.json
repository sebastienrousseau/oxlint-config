{
  "name": "@sebastienrousseau/oxlint-config",
  "version": "0.0.7",
  "description": "Shareable Oxlint configuration rules for 50x–100x faster Rust-powered JS/TS linting.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/oxlint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/oxlint-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/oxlint-config/issues"
  },
  "keywords": [
    "oxlint",
    "oxlint-config",
    "config-preset",
    "developer-tools"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    ".oxlintrc.json",
    "oxlint-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.7",
    "oxlint": "^1.30.0"
  },
  "configKit": {
    "shape": "object",
    "presets": [
      ".oxlintrc.json"
    ],
    "validate": "oxlint",
    "nativeToolchain": "oxlint"
  }
}
